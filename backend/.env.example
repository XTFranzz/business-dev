# --- Supabase ---
# Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Newer Supabase "secret key" format (sb_secret_...) - equivalent server-side admin credential
SUPABASE_SECRET_KEY=
# Project Settings -> API -> JWT Secret (used to verify tokens issued by Supabase Auth)
SUPABASE_JWT_SECRET=

# --- Database ---
# Project Settings -> Database -> Connection string (URI, "Session pooler" or direct connection)
# SQLAlchemy needs the psycopg driver prefix: postgresql+psycopg://...
DATABASE_URL=postgresql+psycopg://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# --- Discovery providers ---
GOOGLE_PLACES_API_KEY=

# --- AI (Phase 2+, not used yet) ---
OPENAI_API_KEY=

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
